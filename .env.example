# Choose DATABASE_URL, or set all four required DB_* values below.
# DATABASE_URL takes priority over DB_* when supplied in the same source.
# The launcher preserves OS > project .env precedence and rejects partial OS DB_*.
# DATABASE_URL=mysql+pymysql://user:percent-encoded-password@host:3306/database
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:8017,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173
# Generate a private random value of at least 32 characters.
CURSOR_SIGNING_KEY=
# Loopback-only development exception; keep false outside local development.
LOCAL_HTTP_COOKIE=true
RATE_LIMIT_ENABLED=true
# Optional review UI directory, relative to project root or absolute.
# FRONTEND_DIR=../WOOWANGTHON_TEAM_17_FE/dist
