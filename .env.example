# Apply the explicit migration separately; the app never changes schemas.
DATABASE_URL=mysql+pymysql://trip_app:replace-me@127.0.0.1:3306/chungbuk_trip
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Generate your own long random secret. Do not commit real values.
CURSOR_SIGNING_KEY=replace-with-at-least-32-random-characters
# Explicit loopback-only HTTP development exception. Production must use false.
LOCAL_HTTP_COOKIE=true
RATE_LIMIT_ENABLED=true
